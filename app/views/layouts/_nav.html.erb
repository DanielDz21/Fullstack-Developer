<header class="sticky top-0 z-10 border-b border-gray-200 bg-white">
  <div class="container mx-auto px-5" data-controller="nav-toggle">
    <div class="flex items-center justify-between py-3">
      <%= link_to "Fullstack Developer", Current.user.admin? ? admin_dashboard_path : profile_path, class: "font-bold text-gray-900" %>

      <button type="button" class="link-muted sm:hidden" data-action="nav-toggle#toggle" data-nav-toggle-target="button" aria-label="Toggle navigation" aria-expanded="false">
        Menu
      </button>
    </div>

    <div data-nav-toggle-target="menu" class="hidden flex-col gap-3 pb-4 sm:flex sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:pb-3">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <% if Current.user.admin? %>
          <%= link_to "Dashboard", admin_dashboard_path, class: "link-action" %>
          <%= link_to "Manage users", admin_users_path, class: "link-action" %>
          <%= link_to "Spreadsheet imports", admin_spreadsheet_imports_path, class: "link-action" %>
        <% else %>
          <%= link_to "My Profile", profile_path, class: "link-action" %>
        <% end %>
      </div>

      <%= button_to "Sign out", session_path, method: :delete, class: "link-muted btn-link" %>
    </div>
  </div>
</header>
