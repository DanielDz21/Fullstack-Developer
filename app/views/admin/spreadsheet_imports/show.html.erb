<h1 class="font-bold text-4xl">Spreadsheet Import</h1>
<p class="mt-4 text-gray-500"><%= @spreadsheet_import.file.filename %> — uploaded by <%= @spreadsheet_import.user.full_name %></p>

<%= turbo_stream_from "spreadsheet_import_#{@spreadsheet_import.id}" %>
<%= render "progress", spreadsheet_import: @spreadsheet_import %>

<div class="mt-4">
  <%= link_to "Back to imports", admin_spreadsheet_imports_path, class: "text-blue-600 underline hover:no-underline" %>
</div>
