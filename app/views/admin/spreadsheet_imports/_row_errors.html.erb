<h2 class="font-bold text-xl text-gray-900 mt-8 mb-4">Erros nas Linhas</h2>
<div class="overflow-x-auto bg-white border border-gray-200 rounded-xl shadow-sm">
  <table class="w-full min-w-max text-left border-collapse">
    <thead class="bg-gray-50 border-b border-gray-200">
      <tr>
        <th class="py-3 px-4 font-semibold text-gray-500 text-xs uppercase tracking-wider w-24">Linha</th>
        <th class="py-3 px-4 font-semibold text-gray-500 text-xs uppercase tracking-wider">Motivo</th>
      </tr>
    </thead>
    <tbody id="<%= dom_id(spreadsheet_import, :row_errors) %>" class="divide-y divide-gray-200">
      <%= render partial: "admin/spreadsheet_imports/row_error",
                 collection: spreadsheet_import.spreadsheet_import_row_errors.order(:row_number),
                 as: :row_error %>
    </tbody>
  </table>
</div>
