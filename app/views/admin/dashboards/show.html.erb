<div class="mb-8 flex items-center justify-between border-b border-gray-200 pb-4">
  <div>
    <h1 class="font-bold text-2xl text-gray-900">Painel Administrativo</h1>
    <p class="mt-2 text-gray-600 font-medium">Conectado como <%= Current.user.full_name %> (<%= Current.user.role == 'admin' ? 'Administrador' : 'Usuário Normal' %>).</p>
